[Unit]
Description=VinylKnob - update the Discogs collection
After=vinylknob-brain.service
Requires=vinylknob-brain.service

[Service]
Type=oneshot
User=__USER__
# Generous timeout: several hundred releases means several pages with a 1.1 s
# pause between them, because Discogs allows 60 requests per minute and we stay
# under that.
ExecStart=/usr/bin/curl -fsS --max-time 300 -X POST http://127.0.0.1:8790/api/discogs/sync
