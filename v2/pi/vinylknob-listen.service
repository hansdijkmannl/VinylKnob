[Unit]
Description=VinylKnob ears - listens on the receiver's line feed and asks the brain for a lookup
After=vinylknob-brain.service sound.target
Wants=vinylknob-brain.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/v2/pi
ExecStart=__ROOT__/.venv/bin/python __ROOT__/v2/pi/listen.py
Restart=always
RestartSec=10

# This service serves the web interface, on port 80 as well, so the Pi's address
# alone is enough to reach it. Without this line an ordinary user may not listen
# there and only 8791 is left.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Environment=PYTHONUNBUFFERED=1
Environment=BRAIN_URL=http://127.0.0.1:8790

# The panel's address is normally discovered, not configured: it polls this
# service every four seconds and every request carries its address. Only set
# this if you have more than one panel, or want to reach one that is not
# polling yet.
#Environment=PANEL_HOST=192.168.1.50

# Where the sound comes from. The receiver's address is normally left to the
# panel, which already has it for telnet; set AVR_HOST only if this service runs
# somewhere the panel cannot be reached.
#
# LINE_INPUT is the protocol name in lower case. ./line.sh lists what your
# receiver offers and which of them actually carry signal.
#Environment=AVR_HOST=192.168.1.60
Environment=LINE_INPUT=phono

# The threshold follows the signal, but these numbers decide when a lookup
# happens. Triggering too eagerly: raise TRIGGER_DB. Missing the start of a
# side: lower START_SECONDS. On a line feed there is around 40 dB between the
# noise floor and the music, so 15 is comfortable; with a microphone this had
# to sit at 6.
Environment=TRIGGER_DB=15
# And an absolute floor: never ask about sound too quiet to identify anyway.
# The threshold above is relative to the quiet, so hum or a needle in the
# run-out groove clears it and spends a lookup that cannot succeed. Music on
# this line runs -33 to -48 dBFS, the idle input -80 to -92. Asking by hand
# ignores this.
Environment=MIN_LEVEL_DB=-60
Environment=START_SECONDS=2.5
Environment=SETTLE_SECONDS=4
# Eight, not fifteen. Longer clips recognise a little better and enrol a lot
# faster — which is exactly why fifteen was a mistake once a side is learnt
# continuously: it filled a record's share of the fingerprint database in an
# evening. The cap in local.py is the real guard now, and this is back to a
# length chosen for recognising rather than for hoarding.
Environment=CLIP_SECONDS=8
Environment=QUIET_SECONDS=15
Environment=RETRY_SECONDS=60
# How long the sleeve stays after the last sound. Separate from QUIET_SECONDS,
# which decides when listening may resume.
Environment=COVER_HOLD_SECONDS=300

[Install]
WantedBy=multi-user.target
