[Unit]
Description=MarantzKnob brain - recognition, Discogs and the web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/v2/pi
ExecStart=__ROOT__/.venv/bin/python __ROOT__/v2/pi/web.py
Restart=always
RestartSec=5

# Unbuffered, or journalctl shows nothing for minutes at a time.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
