[Unit]
Description=MarantzKnob — Discogs-collectie bijwerken
After=marantzknob-brein.service
Requires=marantzknob-brein.service

[Service]
Type=oneshot
User=__GEBRUIKER__
# Ruime timeout: 548 releases zijn zes pagina's met een pauze van 1,1 s ertussen,
# want Discogs staat 60 verzoeken per minuut toe en daar blijven we onder.
ExecStart=/usr/bin/curl -fsS --max-time 300 -X POST http://127.0.0.1:8790/api/discogs/sync
