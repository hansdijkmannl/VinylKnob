[Unit]
Description=MarantzKnob brein — herkenning, Discogs en de webinterface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__GEBRUIKER__
WorkingDirectory=__WORTEL__/luxe/pi
ExecStart=__WORTEL__/.venv/bin/python __WORTEL__/luxe/pi/web.py
Restart=always
RestartSec=5

# Ongebufferd, anders staat er minutenlang niets in journalctl.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
