[Unit]
Description=MarantzKnob — dagelijks de Discogs-collectie bijwerken

[Timer]
# 's Nachts, met spreiding zodat niet iedereen Discogs op hetzelfde moment
# aantikt. Persistent: staat de Pi uit geweest, dan haalt hij het bij het
# opstarten alsnog in plaats van een dag over te slaan.
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
